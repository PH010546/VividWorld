    <!-- Sample template 1: duel_arranged -->
    <string id="VividWorld_Fact_DuelArranged_Who" text="{CHALLENGER} challenged {TARGET} to an honorable duel" />
    <string id="VividWorld_Fact_DuelArranged_Where" text="outside the walls of {SETTLEMENT}" />
    <string id="VividWorld_Fact_DuelArranged_What" text="weapons were inspected and rules declared" />
    <string id="VividWorld_Fact_DuelArranged_Why" text="over a matter of family honor" />

    <!-- Sample template 2: tavern_quarrel -->
    <string id="VividWorld_Fact_TavernQuarrel_Who" text="{INSTIGATOR} brawled with {TARGET}" />
    <string id="VividWorld_Fact_TavernQuarrel_Where" text="in a tavern at {SETTLEMENT}" />
    <string id="VividWorld_Fact_TavernQuarrel_What" text="flinging tankards and drawing blades" />
    <string id="VividWorld_Fact_TavernQuarrel_Why" text="over an unpaid gambling debt" />
    <string id="VividWorld_Fact_TavernQuarrel_Outcome" text="the town watch had to intervene" />

    <!-- Sample template 3: shared_meal -->
    <string id="VividWorld_Fact_SharedMeal_Who" text="{HOST} shared a simple meal with {GUEST}" />
    <string id="VividWorld_Fact_SharedMeal_Where" text="at {SETTLEMENT}" />
    <string id="VividWorld_Fact_SharedMeal_What" text="partaking in local wine and roasted meats" />
    <string id="VividWorld_Fact_SharedMeal_Outcome" text="both parted in peaceful spirits" />

    <!-- Sample template 4: duel -->
    <string id="VividWorld_Fact_Duel_Who" text="{DUELIST} engaged in a bloody duel with {RIVAL}" />
    <string id="VividWorld_Fact_Duel_Where" text="near {SETTLEMENT}" />
    <string id="VividWorld_Fact_Duel_Context" text="escalating from the tavern quarrel" />
    <string id="VividWorld_Fact_Duel_What" text="steel clashed until the sands were stained crimson" />
    <string id="VividWorld_Fact_Duel_Outcome" text="{DUELIST} stood victorious over the fallen rival" />

    <!-- Sample template 5: covert_sabotage -->
    <string id="VividWorld_Fact_CovertSabotage_WhoMastermind" text="{MASTERMIND}" />
    <string id="VividWorld_Fact_CovertSabotage_WhoTarget" text="{TARGET}" />
    <string id="VividWorld_Fact_CovertSabotage_WhoAgent" text="{AGENT}" />
    <string id="VividWorld_Fact_CovertSabotage_When" text="two days before the duel" />
    <string id="VividWorld_Fact_CovertSabotage_Context" text="while {TARGET} was preparing for the arranged duel" />
    <string id="VividWorld_Fact_CovertSabotage_Why" text="hoping to weaken {TARGET} before the combat" />
    <string id="VividWorld_Fact_CovertSabotage_What" text="{MASTERMIND} bribed {AGENT} to sabotage the steed" />
    <string id="VividWorld_Fact_CovertSabotage_Outcome" text="the steed was indeed found lame on the morrow" />

