    <!-- SNAP1: snapshot manager -->
    <string id="VividWorld_Snapshots_Title" text="Vivid World Snapshot Manager" />
    <string id="VividWorld_Snapshots_Desc" text="A snapshot is what Vivid World uses to put the rumors back the way they were when you saved. Delete a snapshot while its save game is still there and Vivid World will start behaving oddly with that save. It is best to delete a snapshot only once its save game is gone. You have {COUNT}, taking up {SIZE}." />
