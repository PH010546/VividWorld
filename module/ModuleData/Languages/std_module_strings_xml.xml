    <!-- Real event template 1: hero_murdered -->
    <string id="VividWorld_Fact_HeroMurdered_Who" text="{KILLER} murdered {VICTIM} in cold blood" />
    <string id="VividWorld_Fact_HeroMurdered_Where" text="near {SETTLEMENT}" />
    <string id="VividWorld_Fact_HeroMurdered_What" text="the deed was done in secret and without mercy" />
    <string id="VividWorld_Fact_HeroMurdered_Outcome" text="the foul crime has cast a grim shadow over the realm" />

    <!-- Real event template 2: hero_executed -->
    <string id="VividWorld_Fact_HeroExecuted_Who" text="{KILLER} formally executed {VICTIM}" />
    <string id="VividWorld_Fact_HeroExecuted_Where" text="at {SETTLEMENT}" />
    <string id="VividWorld_Fact_HeroExecuted_What" text="the headsman's axe severed the noble head before assembled crowds" />
    <string id="VividWorld_Fact_HeroExecuted_Outcome" text="the execution sent shockwaves across the continent" />

    <!-- Real event template 3: hero_died_in_battle -->
    <string id="VividWorld_Fact_HeroDiedInBattle_Who" text="{VICTIM} was slain in battle by {KILLER}" />
    <string id="VividWorld_Fact_HeroDiedInBattle_Where" text="on the field near {SETTLEMENT}" />
    <string id="VividWorld_Fact_HeroDiedInBattle_What" text="fighting bravely amidst the clash of shields and spears" />
    <string id="VividWorld_Fact_HeroDiedInBattle_Outcome" text="the warrior met an honorable end on the field of war" />

    <!-- Real event template 4: hero_died_naturally -->
    <string id="VividWorld_Fact_HeroDiedNaturally_Who" text="{VICTIM} passed away peacefully" />
    <string id="VividWorld_Fact_HeroDiedNaturally_Where" text="at {SETTLEMENT}" />
    <string id="VividWorld_Fact_HeroDiedNaturally_What" text="surrounded by family and kin as life slipped away" />
    <string id="VividWorld_Fact_HeroDiedNaturally_Outcome" text="mourners paid tribute to a life well-lived" />

    <!-- Real event template 5: hero_taken_prisoner -->
    <string id="VividWorld_Fact_HeroTakenPrisoner_Who" text="{CAPTOR} captured {PRISONER} as a prisoner of war" />
    <string id="VividWorld_Fact_HeroTakenPrisoner_Where" text="near {SETTLEMENT}" />
    <string id="VividWorld_Fact_HeroTakenPrisoner_What" text="stripped of weapons and placed under close guard" />
    <string id="VividWorld_Fact_HeroTakenPrisoner_Outcome" text="the captive remains in custody awaiting ransom or release" />

    <!-- Real event template: hero_released -->
    <string id="VividWorld_Fact_HeroReleased_Who" text="{CAPTOR} set {PRISONER} free" />
    <string id="VividWorld_Fact_HeroReleased_WhoNoCaptor" text="{PRISONER} is out of captivity" />
    <string id="VividWorld_Fact_HeroReleased_Where" text="near {SETTLEMENT}" />
    <string id="VividWorld_Fact_HeroReleased_What" text="the terms were settled and the guards stood aside" />
    <string id="VividWorld_Fact_HeroReleased_Outcome" text="the captive is no longer held" />

    <!-- Real event template: hero_escaped_captivity -->
    <string id="VividWorld_Fact_HeroEscaped_Who" text="{PRISONER} slipped out of {CAPTOR}'s custody" />
    <string id="VividWorld_Fact_HeroEscaped_WhoNoCaptor" text="{PRISONER} slipped out of captivity" />
    <string id="VividWorld_Fact_HeroEscaped_Where" text="near {SETTLEMENT}" />
    <string id="VividWorld_Fact_HeroEscaped_What" text="the guard was thin and the night was long" />
    <string id="VividWorld_Fact_HeroEscaped_Outcome" text="nobody is quite sure which way he went" />

    <!-- Real event template 6: heroes_married -->
    <string id="VividWorld_Fact_HeroesMarried_Who" text="{SPOUSE_A} and {SPOUSE_B} were united in marriage" />
    <string id="VividWorld_Fact_HeroesMarried_Where" text="at {SETTLEMENT}" />
    <string id="VividWorld_Fact_HeroesMarried_What" text="vows were exchanged with grand feasting and celebration" />
    <string id="VividWorld_Fact_HeroesMarried_Outcome" text="the alliance binds two noble lines in enduring friendship" />

    <!-- Real event template 7: child_born -->
    <string id="VividWorld_Fact_ChildBorn_Who" text="{MOTHER} gave birth to a healthy child {CHILD}" />
    <string id="VividWorld_Fact_ChildBorn_Where" text="at {SETTLEMENT}" />
    <string id="VividWorld_Fact_ChildBorn_What" text="the newborn arrived safely after a long labor" />
    <string id="VividWorld_Fact_ChildBorn_Outcome" text="the clan rejoiced at the blessing of a new heir" />

    <!-- Situation 1: seat_dispute -->
    <string id="VividWorld_Fact_SeatDisputeDemanded_Who" text="{SLIGHTED} demanded that {FAVORED} give up the seat of honor" />
    <string id="VividWorld_Fact_SeatDisputeDemanded_Where" text="in the hall of {SETTLEMENT}" />
    <string id="VividWorld_Fact_SeatDisputeDemanded_Why" text="saying the head of a house should not sit below a lesser member of another" />
    <string id="VividWorld_Fact_SeatDisputeDemanded_Outcome" text="and the whole hall fell silent" />
    <string id="VividWorld_Fact_SeatDisputeEndured_Who" text="{SLIGHTED} swallowed the insult of sitting below {FAVORED}" />
    <string id="VividWorld_Fact_SeatDisputeEndured_Where" text="in the hall of {SETTLEMENT}" />
    <string id="VividWorld_Fact_SeatDisputeEndured_What" text="but has not forgotten it" />
    <string id="VividWorld_Fact_SeatDisputeYielded_Who" text="{SLIGHTED} graciously gave the seat of honor to {FAVORED}" />
    <string id="VividWorld_Fact_SeatDisputeYielded_Where" text="in the hall of {SETTLEMENT}" />
    <string id="VividWorld_Fact_SeatDisputeYielded_Outcome" text="and raised a cup in their honor" />
    <string id="VividWorld_Fact_SeatDisputeWalkedOut_Who" text="{SLIGHTED} walked out of {HOST}'s feast" />
    <string id="VividWorld_Fact_SeatDisputeWalkedOut_Where" text="in {SETTLEMENT}" />
    <string id="VividWorld_Fact_SeatDisputeWalkedOut_Why" text="rather than sit below {FAVORED}" />
    <string id="VividWorld_Dev_TriggerSituation" text="(dev) Trigger a situation here" />
    <string id="VividWorld_Dev_GrudgeLedger" text="(dev) His ledger of grudges" />
    <string id="VividWorld_Dev_ScanToday" text="(dev) Today's situation scan" />
    <string id="VividWorld_Dev_Snapshots" text="(dev) Snapshot state" />

    <!-- Situation 2: advice_sought -->
    <string id="VividWorld_Fact_AdviceGivenFreely_Who" text="{VETERAN} told {STUDENT} how that campaign was really won" />
    <string id="VividWorld_Fact_AdviceGivenFreely_Where" text="in {SETTLEMENT}" />
    <string id="VividWorld_Fact_AdviceGivenFreely_What" text="and held nothing back, down to his own mistakes" />
    <string id="VividWorld_Fact_AdviceBrushedOff_Who" text="{VETERAN} gave {STUDENT} nothing but old sayings" />
    <string id="VividWorld_Fact_AdviceBrushedOff_Where" text="in {SETTLEMENT}" />
    <string id="VividWorld_Fact_AdviceBrushedOff_What" text="and changed the subject before the cup was empty" />
    <string id="VividWorld_Fact_AdviceMocked_Who" text="{VETERAN} made a joke of {STUDENT}'s questions in front of the hall" />
    <string id="VividWorld_Fact_AdviceMocked_Where" text="in {SETTLEMENT}" />
    <string id="VividWorld_Fact_AdviceMocked_Why" text="saying some men should first learn to sit still" />
    <string id="VividWorld_Fact_AdviceMocked_Outcome" text="and the laughter followed {STUDENT} out of the hall" />

    <!-- Situation 3: tavern_words -->
    <string id="VividWorld_Fact_TavernGoodWord_Who" text="{SPEAKER} spoke up for {LISTENER} when the table turned on him" />
    <string id="VividWorld_Fact_TavernGoodWord_Where" text="in a tavern in {SETTLEMENT}" />
    <string id="VividWorld_Fact_TavernGoodWord_What" text="and said he would tell them the same sober" />
    <string id="VividWorld_Fact_TavernBoastTold_Who" text="{SPEAKER} boasted to {LISTENER} of deeds that grew with every cup" />
    <string id="VividWorld_Fact_TavernBoastTold_Where" text="in a tavern in {SETTLEMENT}" />
    <string id="VividWorld_Fact_TavernBoastTold_What" text="and nobody at the table troubled to count the bodies" />
    <string id="VividWorld_Fact_TavernConfidence_Who" text="{SPEAKER} admitted to {LISTENER} that the coffers are all but empty" />
    <string id="VividWorld_Fact_TavernConfidence_Where" text="over cups in {SETTLEMENT}" />
    <string id="VividWorld_Fact_TavernConfidence_What" text="and asked that it go no further" />
    <string id="VividWorld_Fact_TavernSourWords_Who" text="{SPEAKER} said something over the cups that {LISTENER} will not forget" />
    <string id="VividWorld_Fact_TavernSourWords_Where" text="in a tavern in {SETTLEMENT}" />
    <string id="VividWorld_Fact_TavernSourWords_What" text="and did not take it back once the wine had worn off" />

    <!-- Situation 4: victory_credit -->
    <string id="VividWorld_Fact_VictoryCreditClaimed_Who" text="{CLAIMANT} claimed the credit for the last victory in front of the whole hall" />
    <string id="VividWorld_Fact_VictoryCreditClaimed_Where" text="in the hall of {SETTLEMENT}" />
    <string id="VividWorld_Fact_VictoryCreditClaimed_Why" text="saying {RIVAL} rode up only after the line had already broken" />
    <string id="VividWorld_Fact_VictoryCreditDeferred_Who" text="{CLAIMANT} handed {RIVAL} the credit for the last victory" />
    <string id="VividWorld_Fact_VictoryCreditDeferred_Where" text="in the hall of {SETTLEMENT}" />
    <string id="VividWorld_Fact_VictoryCreditDeferred_What" text="though the hall had been ready to praise {CLAIMANT} instead" />
    <string id="VividWorld_Fact_VictoryCreditBelittled_Who" text="{CLAIMANT} has been telling a few trusted ears that {RIVAL} did nothing in the last battle" />
    <string id="VividWorld_Fact_VictoryCreditBelittled_Where" text="in {SETTLEMENT}" />
    <string id="VividWorld_Fact_VictoryCreditBelittled_What" text="and is careful never to say it where {RIVAL} might hear" />
    <string id="VividWorld_Fact_VictoryCreditJudged_Who" text="{HOST} settled the quarrel between {CLAIMANT} and {RIVAL} over the last victory" />
    <string id="VividWorld_Fact_VictoryCreditJudged_Where" text="in the hall of {SETTLEMENT}" />
    <string id="VividWorld_Fact_VictoryCreditJudged_Outcome" text="and gave the credit to {RIVAL}" />

    <!-- Situation 5: market_brawl -->
    <string id="VividWorld_Fact_BrawlManHandedOver_Who" text="{PATRON} handed over the man who drew first and made his apology to {AGGRIEVED}" />
    <string id="VividWorld_Fact_BrawlManHandedOver_Where" text="in {SETTLEMENT}" />
    <string id="VividWorld_Fact_BrawlManHandedOver_What" text="with the whole market square watching" />
    <string id="VividWorld_Fact_BrawlShieldedOwn_Who" text="{PATRON} refused to give up his man to {AGGRIEVED}" />
    <string id="VividWorld_Fact_BrawlShieldedOwn_Where" text="in {SETTLEMENT}" />
    <string id="VividWorld_Fact_BrawlShieldedOwn_Why" text="saying his household answers to his house and no other" />
    <string id="VividWorld_Fact_BrawlCounterAccused_Who" text="{PATRON} told the hall it was {AGGRIEVED}'s man who drew first" />
    <string id="VividWorld_Fact_BrawlCounterAccused_Where" text="in {SETTLEMENT}" />
    <string id="VividWorld_Fact_BrawlCounterAccused_What" text="and demanded an accounting of his own" />
    <string id="VividWorld_Fact_BrawlCounterAccused_Outcome" text="neither house gave an inch" />
    <string id="VividWorld_Fact_BrawlHushedUp_Who" text="{AGGRIEVED} and {PATRON} agreed to let the market brawl die quietly" />
    <string id="VividWorld_Fact_BrawlHushedUp_Where" text="in {SETTLEMENT}" />
    <string id="VividWorld_Fact_BrawlHushedUp_What" text="and neither house will speak of it again" />

    <!-- Situation 6: hunt_wager -->
    <string id="VividWorld_Fact_WagerStruck_Who" text="{CHALLENGER} and {CHALLENGED} struck a wager on the next hunt" />
    <string id="VividWorld_Fact_WagerStruck_Where" text="in {SETTLEMENT}" />
    <string id="VividWorld_Fact_WagerStruck_What" text="and half the hall put silver on it as well" />
    <string id="VividWorld_Fact_WagerRefused_Who" text="{CHALLENGED} refused {CHALLENGER}'s wager and made a joke of the asking" />
    <string id="VividWorld_Fact_WagerRefused_Where" text="in {SETTLEMENT}" />
    <string id="VividWorld_Fact_WagerRefused_What" text="which the hall laughed at rather too long" />
    <string id="VividWorld_Fact_WagerSecretStake_Who" text="{CHALLENGER} and {CHALLENGED} put more than silver on the next hunt" />
    <string id="VividWorld_Fact_WagerSecretStake_Where" text="in {SETTLEMENT}" />
    <string id="VividWorld_Fact_WagerSecretStake_What" text="and neither of them will say what it was" />

