    <string id="VividWorld_Snapshots_Cancel" text="Cancel" />
    <string id="VividWorld_Snapshots_None" text="No snapshots yet - one is taken every time you save." />
    <string id="VividWorld_Snapshots_SaveExists" text="save exists" />
    <string id="VividWorld_Snapshots_SaveGone" text="save deleted" />
    <string id="VividWorld_Snapshots_FolderMissing" text="folder missing" />
