    <string id="VividWorld_Snapshots_SomeFailed" text="{COUNT} could not be deleted - see log.txt." />
    <string id="VividWorld_Snapshots_ConfirmTitle" text="Those saves are still there" />
    <string id="VividWorld_Snapshots_ConfirmText" text="{COUNT} of the snapshots you ticked still have their save game. Delete them and those saves can no longer rewind their rumors. Delete anyway?" />
